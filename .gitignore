# ---- Git worktrees (SDD 작업 격리) ----
.worktrees/

# ---- Gradle / Java ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
out/
!**/src/main/**/out/
!**/src/test/**/out/
*.class
*.war
.kotlin

# ---- 로컬 설정 · 시크릿 (절대 커밋 금지) ----
**/application-local.properties
**/*-local.properties
!**/*-local.properties.example
**/secret*.properties
**/*.key
**/*.pem
.env
.env.*
!.env.example

# ---- 상호 사전 생성물 (db/merchant_directory/README.md) ----
db/merchant_directory/*.sql
db/merchant_directory/*.sql.gz
# ---- Node / Vue ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---- IDE (개인 설정 — 전체 제외) ----
# .idea 하위에는 DB 접속정보(dataSources)와 개인 작업 상태(workspace.xml)가 들어간다.
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
.metadata/
nbproject/
/.nb-gradle/

# ---- Eclipse ----
.apt_generated
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 로그 · 임시 ----
logs/
*.log
*.tmp
_to_delete/

# ---- AI 도구 개인 설정 (팀 공용 규칙 파일·스킬은 커밋 대상) ----
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json
.claude/hooks/

# ---- AI 작업 산출물 (개인 참고용 — 저장소에 올리지 않는다) ----
# 설계서·구현계획은 로컬에만 둔다. 결정 근거는 PR 본문과 .claude/context/ 에 남긴다.
docs/superpowers/
.superpowers/
