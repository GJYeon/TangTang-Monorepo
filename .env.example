# 이 파일을 .env 로 복사한 뒤 본인 값으로 채운다. (.env 는 .gitignore 대상)
#   cp .env.example .env
#
# ⚠️ MYSQL_PASSWORD 는 아래 두 곳과 반드시 같은 값이어야 한다.
#    - db/00_init_local_db.sql          (로컬 MySQL 에 계정을 만들 때)
#    - apps/api/.../application-local.properties (백엔드가 접속할 때)

# === MySQL ===
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=tangtang
MYSQL_USER=tangtang
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# === 인증 (JWT · 구글 OAuth) ===
# JWT_SECRET 은 HS256 이라 32자 이상이어야 한다.
#   PowerShell: $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# === OpenAI (월간 리포트 분석 · LLM 거래 카테고리화) ===
# https://platform.openai.com/api-keys 에서 발급. 팀 공용 키가 있으면 팀 채널에서 받는다.
# ⚠ 비워두면 docker compose 기동 시 컨텍스트 로딩이 실패한다 (이슈 #147 후속).
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
#OPENAI_MODEL=gpt-5-nano
#OPENAI_MAX_OUTPUT_TOKENS=2048
#OPENAI_REASONING_EFFORT=low
#OPENAI_CONNECT_TIMEOUT_MILLIS=3000
#OPENAI_READ_TIMEOUT_MILLIS=15000

# === 배포 환경 주소 (docker compose 로 띄울 때만 사용) ===
# Vercel 프론트 주소. 구글 콜백 후 사용자를 되돌려보낼 곳이다.
APP_FRONT_URL=https://monorepo-three-ruby-81.vercel.app
# 구글 콘솔의 "승인된 리디렉션 URI" 와 문자 하나까지 같아야 한다.
GOOGLE_OAUTH_REDIRECT_URI=https://monorepo-three-ruby-81.vercel.app/api/auth/google/callback
# Vercel 은 HTTPS 라 true. 로컬에서 docker compose 를 http://localhost 로 띄워 쓸 때는 false 로 둔다
# (Secure 쿠키는 HTTPS 에서만 저장되므로 http 로 접속하면 로그인이 유지되지 않는다).
AUTH_COOKIE_SECURE=true

# === 포트 바인딩 (이슈 #225) ===
# 기본값은 지금까지와 같은 전체 공개다.
#
# API_BIND — 8080 은 Vercel 의 rewrite 가 직접 때리는 평문 경로다. 아직 127.0.0.1 로 막으면
#   서비스가 멈춘다. https 전환은 후속 이슈이며, 배포 환경의 TLS 구조는 docs/DEPLOY_WEBSOCKET.md.
#API_BIND=127.0.0.1
# DB_BIND — MySQL 3307. 2026-08-19 부터 AWS 보안그룹에서 인터넷 노출을 차단했다.
#   팀은 SSH 터널로 EC2 DB 에 붙는다. 여기까지 막으면 EC2 안에서만 접근 가능해진다.
#DB_BIND=127.0.0.1

# === Swagger 문서 접근 (이슈 #225) ===
# 배포 서버는 공인 IP 라 /swagger-ui.html 이 무인증으로 공개됐었다. Basic 인증 한 겹을 둔다.
# ⚠ **비워두면 배포 환경에서 문서가 404 로 숨는다.** 설정을 빠뜨린 채 배포됐을 때
#   문서가 열린 채 남는 것보다 안 보이는 편이 낫기 때문이다. 팀 공유용 값은 팀 채널에서 받는다.
#   로컬(APP_ENV 없음)은 이 값과 무관하게 그대로 열린다.
SWAGGER_ACCESS_USERNAME=tangtang
SWAGGER_ACCESS_PASSWORD=여기에_팀_공유_비밀번호_입력

# === 배치 시각 (이슈 #387) ===
# 고정지출 탐지 배치. 기본 23:00 — 하루 소비가 사실상 끝난 뒤에 돌린다.
# 앞당기면 저녁 소비(외식·배달·귀갓길 결제)가 그날 탐지에 잡히지 않고 다음 날로 밀린다.
# 형식은 Spring cron 6필드(초 분 시 일 월 요일). 시연 때 임의 시각으로 당길 일이 있으면 여기서 바꾼다.
# ⚠ 비워두면 앱이 cron 파싱에 실패해 기동하지 못한다. 지울 거면 줄 전체를 지운다.
FIXED_EXPENSE_DETECTION_CRON=0 0 23 * * *

# === 월간 리포트 수동 배치 운영 키 (이슈 #478) ===
# POST /api/dev/reports/monthly/batch 를 `X-Report-Batch-Key` 헤더로 보호하는 값이다.
# 자정 배치를 기다리지 않고 리포트를 만들 때 쓴다. 로컬·배포 양쪽에서 동작한다.
# 비워두면 그 API 만 MANUAL_REPORT_BATCH_DISABLED 로 막힌다 — 앱 기동에는 영향이 없다.
REPORT_MONTHLY_MANUAL_BATCH_KEY=

# === CODEF API (실제 자산 연동) ===
CODEF_API_URL=https://api.codef.io
CODEF_CLIENT_ID=여기에_클라이언트ID_입력
CODEF_CLIENT_SECRET=여기에_클라이언트시크릿_입력
# CODEF 마이페이지 > 키 관리의 공개키(헤더 없는 Base64 한 줄). codef/hybrid 모드에서 필수.
CODEF_PUBLIC_KEY=
# 금융 데이터 공급자. mock = 모두 목서버 / codef = 모두 실 CODEF /
# hybrid = 사용자별(tbl_user.financial_data_source 가 CODEF 인 사용자만 실 CODEF)
FINANCIAL_CLIENT=mock

# === 이미지 저장소 (프로필 이미지 · 변론 증빙 사진, 이슈 #162) ===
# local = 컨테이너 볼륨(uploads) / s3 = AWS S3.
# 로컬 개발은 local 로 두면 된다 — 아래 AWS 값 4개를 비워도 정상 기동한다.
# s3 로 바꾸면 프로필 이미지와 변론 증빙 사진이 함께 S3 로 간다(저장소가 하나다).
IMAGE_STORAGE=local

# === AWS S3 (IMAGE_STORAGE=s3 일 때만 필요) ===
# 버킷은 프리픽스로 용도를 나눠 하나만 쓴다: profile/** · defense/**
# 버킷 정책에서 두 프리픽스를 모두 공개해야 한다. profile 만 열면 증빙 사진이 403 이 된다.
AWS_ACCESS_KEY_ID=여기에_액세스키_입력
AWS_SECRET_ACCESS_KEY=여기에_시크릿키_입력
AWS_S3_BUCKET=여기에_버킷이름_입력
AWS_REGION=ap-northeast-2

# === Redis (그룹 채팅, 이슈 #174) ===
# docker compose 안에서는 서비스명으로 부른다. 로컬에서 도커 밖 API 를 띄우면 localhost 로 바꾼다.
REDIS_HOST=redis
REDIS_PORT=6379

# === 토스증권 Open API (주식 시세 연동, 이슈 #299) ===
# 비워 둬도 컨테이너는 정상 기동한다 — 보유 주식 시세만 갱신되지 않는다.
# 실제 값을 넣을 때는 토스 개발자 콘솔에 이 서버의 아웃바운드 IP 를 등록해야 한다(미등록 시 403).
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
